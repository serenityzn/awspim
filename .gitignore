# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
pim-slack-bot

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Config files
config.yaml
config-prod.yaml
config.yaml-prod
config.json
config.toml
config.yml
config.ini
config.env

# Binaries
awspim
pim-slack-bot

# GoReleaser artifacts
dist/
*.tar.gz
*.zip
checksums.txt
